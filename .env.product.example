# ── Product stack configuration (docker-compose.product.yml) ────────────────
# Copy to .env and fill in. These are PLATFORM secrets — tenants bring their
# own API keys (Gemini, Tavily, Tuya, …) through the settings UI.

ENVIRONMENT=development

# Postgres
POSTGRES_USER=pa
POSTGRES_PASSWORD=
POSTGRES_DB=pa

# Session token signing key. Generate: openssl rand -hex 32
SESSION_SECRET=

# Master key (KEK) wrapping per-tenant data-encryption keys. Fernet format.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Moving to AWS later: replace with a KMS key (SECRETS_BACKEND=aws).
SECRETS_MASTER_KEY=

# Platform Google OAuth client (Cloud Console → Credentials → OAuth client).
# Used for "Sign in with Google" AND the Gmail/Calendar/Drive consent flow.
# Authorized redirect URIs must include:
#   {PRODUCT_BASE_URL}/auth/callback
#   {PRODUCT_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the product (the nginx gateway)
PRODUCT_BASE_URL=http://localhost:8080

# The Google account email that owns this deployment (seeded as owner/admin).
# If empty, the FIRST account to sign in becomes the owner.
OWNER_EMAIL=

USER_TIMEZONE=Asia/Jerusalem
LOG_FORMAT=json
