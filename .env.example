# ── Environment ────────────────────────────────────────────────────────────
# Set to "production" to hard-fail on startup if any required secret is missing.
# Leave as "development" (default) to only log warnings.
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=pa
POSTGRES_PASSWORD=changeme          # CHANGE THIS — use a strong random password
POSTGRES_DB=pa

# WAHA
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=changeme    # CHANGE THIS
WAHA_API_KEY=                       # Recommended: openssl rand -hex 32

# Your WhatsApp ID (format: 972501234567@c.us — country code + number, no + or spaces)
MY_WHATSAPP_ID=
# Optional: your WhatsApp @lid (newer multi-device format). Auto-detected at startup.
# Set manually if self-chat detection breaks: find it in backend logs ("own @lid").
MY_WHATSAPP_LID=

# ── Security (all recommended for production) ──────────────────────────────

# Shared secret embedded in the WAHA webhook URL to reject unsigned payloads.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# Bearer token for the dev-only POST /test endpoint. Leave empty to block /test entirely.
# Generate: openssl rand -hex 32
TEST_TOKEN=

# Fernet key for encrypting Google OAuth tokens at rest in PostgreSQL.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if you lose this key you will need to re-authenticate Google.
DB_ENCRYPTION_KEY=

# ── Web Push Notifications (VAPID) ─────────────────────────────────────────
# Generate: docker compose exec backend python -c "from app.push_notifications import print_vapid_keys; print_vapid_keys()"
# If unset, ephemeral keys are auto-generated (push subscriptions break on restart).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Must be a mailto: URI — used in VAPID claims sent to push services.
VAPID_SUBJECT=mailto:admin@example.com

# ── LLM ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Web search ─────────────────────────────────────────────────────────────
# Optional — bot falls back to DuckDuckGo when not set
TAVILY_API_KEY=

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
OAUTHLIB_INSECURE_TRANSPORT=0

# ── Google Cloud TTS (Neural2) — leave empty to use edge-tts fallback ──────
# Enable "Cloud Text-to-Speech API" in Google Cloud Console, then create an API key.
GOOGLE_TTS_API_KEY=

# ── Tuya smart-home ────────────────────────────────────────────────────────
TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com
TUYA_PREFER_LOCAL=false

# ── Ecovacs robot vacuum ────────────────────────────────────────────────────
# Your Ecovacs app login credentials (same as the Ecovacs/Home app)
ECOVACS_EMAIL=
ECOVACS_PASSWORD=
ECOVACS_COUNTRY=il          # 2-letter country code (il, us, de, ...)
ECOVACS_CONTINENT=eu        # eu | na | as
ECOVACS_DEVICE_SERIAL=      # optional — leave empty if you have only one vacuum

# ── Obsidian vault (long-term memory) ──────────────────────────────────────
# Path on the HOST to your Obsidian vault. The folder will be bind-mounted
# into the backend container at /app/obsidian_vault. Use forward slashes on
# Windows.
# Examples:
#   Windows native:  D:/Obsidian/MyVault
#   WSL2:            /mnt/d/Obsidian/MyVault
#   In-repo (test):  ./obsidian_vault
HOST_OBSIDIAN_VAULT=D:/Obsidian/MyVault

# Optional: comma-separated whitelist of allowed top-level folder names.
# Off-list categories from the LLM silently fall into "Misc".
OBSIDIAN_CATEGORIES=System,People,Entities,Investments,Projects,Preferences,Misc

# ── Fitness ────────────────────────────────────────────────────────────────
# Weekly workout session target (used in morning brief compliance report)
FITNESS_WEEKLY_SESSION_TARGET=4

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────
# Create at: https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels
# Configure public hostname to route to http://backend:8000
TUNNEL_TOKEN=

# ── CORS ───────────────────────────────────────────────────────────────────
# Set to your public-facing domain so the browser can make API requests.
# Must match the origin the frontend is served from (no trailing slash).
# Example: ALLOWED_ORIGIN=https://pa.yourdomain.com
# Leave empty for local dev (falls back to localhost origins).
ALLOWED_ORIGIN=
