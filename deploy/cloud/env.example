# Cloud stack settings — copied to /opt/pa/.env on the server by bootstrap.sh
# (which also generates the three secrets below). Never commit the real file.

# ── Generated by bootstrap.sh ──────────────────────────────────────────────
POSTGRES_PASSWORD=
SESSION_SECRET=
SECRETS_MASTER_KEY=
DB_ENCRYPTION_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Fill these in ──────────────────────────────────────────────────────────
# Your Google account — first login with it becomes the owner/admin.
OWNER_EMAIL=

# Platform Google OAuth client (Google Cloud Console → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tailscale auth key (admin console → Settings → Keys → Generate auth key).
# Only needed for the very first start; the node identity is then persisted.
TS_AUTHKEY=
TS_HOSTNAME=pa-cloud

# Public URL = https://<TS_HOSTNAME>.<your-tailnet>.ts.net  (no trailing slash)
# Your tailnet name is shown in the Tailscale admin console → DNS.
PRODUCT_BASE_URL=

# ── Optional ───────────────────────────────────────────────────────────────
USER_TIMEZONE=Asia/Jerusalem
LOG_FORMAT=json
