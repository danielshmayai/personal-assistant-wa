# Reference only. bootstrap.sh writes /opt/pa/.env for you, asking just the
# first four values and generating everything else. Never commit a real one.

# ── Asked by bootstrap.sh ──────────────────────────────────────────────────
OWNER_EMAIL=            # your Google account; its first login becomes the admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TS_AUTHKEY=             # used once to join Tailscale, then cleared
TS_HOSTNAME=pa-cloud

# ── Filled in automatically ────────────────────────────────────────────────
PRODUCT_BASE_URL=       # https://pa-cloud.<tailnet>.ts.net, detected from Tailscale
POSTGRES_PASSWORD=
SESSION_SECRET=
SECRETS_MASTER_KEY=     # decrypts users' saved API keys — back it up
DB_ENCRYPTION_KEY=      # decrypts users' Google tokens — back it up
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Optional ───────────────────────────────────────────────────────────────
USER_TIMEZONE=Asia/Jerusalem
LOG_FORMAT=json
# PA_IMAGE_TAG=<commit-sha>   # pin a version (rollback); default: latest
